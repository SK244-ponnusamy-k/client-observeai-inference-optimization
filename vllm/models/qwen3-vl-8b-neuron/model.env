# ==============================================================================
# vllm/models/qwen3-vl-8b-neuron/model.env  - GENERATED by `oai model generate qwen3-vl-8b-neuron`
#
# Neuron / Trainium serving path. Edit catalog/models/qwen3-vl-8b-neuron.yaml and re-generate.
#
# Workflow: first deploy with --compile (produces NEFF cache in S3), then every
# later deploy reuses the cache and starts fast.
#
#   oai deploy qwen3-vl-8b-neuron --compile      # first time
#   oai deploy qwen3-vl-8b-neuron                # subsequent (fast)
# ==============================================================================

export MODEL_ID="qwen3-vl-8b-neuron"
export MODEL_HF_ID="Qwen/Qwen3-VL-8B-Instruct"

# S3 folder with the raw bf16 weights - compile job INPUT.
export SOURCE_FOLDER="Qwen3-VL-8B-Instruct"
# S3 folder that holds the model the deployment serves from.
export MODEL_FOLDER="Qwen3-VL-8B-Instruct"
# S3 folder for compiled NEFF artifacts.
export NEFF_FOLDER="qwen3-vl-8b-neuron"

export SERVED_NAME="Qwen3-VL-8B-Instruct"
export MODEL_S3_PATH="s3://${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-qwen3-vl-8b-neuron"
export SERVICE_NAME="oai-infopt-vllm-qwen3-vl-8b-neuron"

# ── Hardware defaults ─────────────────────────────────────────────────────────
export NEURON_INSTANCE_TYPE="trn2.3xlarge"
# NEURON_CORES = tensor-parallel degree; must equal the compile-time value.
export NEURON_CORES="4"

# Compile-time bucket parameters - must match compile-job.yaml.
export SEQ_LEN="8192"
export BATCH_SIZE="4"

export MANIFEST_PATH="configs/manifests/qwen3-vl-8b-neuron-trn2-bf16.yaml"
export PORT_FORWARD_PORT="8152"

# ── Managed node group fallback (used with --managed-ng) ─────────────────────
export TRN2_NODEGROUP_NAME="trn2-neuron"
