# ==============================================================================
# vllm/models/gpt-oss-20b-neuron/model.env  - GENERATED by `oai model generate gpt-oss-20b-neuron`
#
# Neuron / Trainium serving path. Edit catalog/models/gpt-oss-20b-neuron.yaml and re-generate.
#
# Workflow: first deploy with --compile (produces NEFF cache in S3), then every
# later deploy reuses the cache and starts fast.
#
#   oai deploy gpt-oss-20b-neuron --compile      # first time
#   oai deploy gpt-oss-20b-neuron                # subsequent (fast)
# ==============================================================================

export MODEL_ID="gpt-oss-20b-neuron"
export MODEL_HF_ID="openai/gpt-oss-20b"

# S3 folder with the raw bf16 weights - compile job INPUT.
export SOURCE_FOLDER="gpt-oss-20b"
# S3 folder that holds the model the deployment serves from.
export MODEL_FOLDER="gpt-oss-20b"
# S3 folder for compiled NEFF artifacts.
export NEFF_FOLDER="gpt-oss-20b-neuron"

export SERVED_NAME="gpt-oss-20b"
export MODEL_S3_PATH="s3://${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-gpt-oss-20b-neuron"
export SERVICE_NAME="oai-infopt-vllm-gpt-oss-20b-neuron"

# ── Hardware defaults ─────────────────────────────────────────────────────────
export NEURON_INSTANCE_TYPE="trn2.3xlarge"
# LNC=2 explicit: fuse 2 physical NeuronCores into 1 logical core on trn2.
# Must be identical at compile AND serve time.
export NEURON_LOGICAL_NC_CONFIG="2"
# NEURON_CORES = tensor-parallel degree (TP=4 -> 4 logical cores); must equal the compile-time value.
export NEURON_CORES="4"

# Compile-time bucket parameters - must match compile-job.yaml.
export SEQ_LEN="8192"
# BATCH_SIZE = top num_seqs bucket. Recompile pass 1 = 32, follow-up pass 2 = 64.
export BATCH_SIZE="32"
# Compiled bucket lists (must match deployment --additional-config and compile-job).
export NUM_SEQS_BUCKETS="1,2,4,8,16,32"
export NUM_BATCHED_TOKENS_BUCKETS="2048,4096,8192"

export MANIFEST_PATH="configs/manifests/gpt-oss-20b-neuron-trn2-bf16.yaml"
export PORT_FORWARD_PORT="8146"

# ── Managed node group fallback (used with --managed-ng) ─────────────────────
export TRN2_NODEGROUP_NAME="trn2-neuron"
