# ==============================================================================
# vllm/models/gpt-oss-20b-neuron/model.env
#
# Model-specific configuration for the Trainium (trn1) / Neuron serving path.
# Sourced by deploy.sh and stop.sh in this directory.
#
# Workflow (one-time compile, fast restarts after):
#   1st deploy:  bash deploy.sh --compile
#                  → compile job reads SOURCE_FOLDER (bf16 weights)
#                  → uploads compiled NEFFs to MODEL_FOLDER (gpt-oss-20b-neuron/)
#                  → deployment.yaml points at MODEL_FOLDER (NEFF cache)
#   All subsequent deploys: bash deploy.sh
#                  → NEFF cache already in S3, skips compile, pod starts fast
#
# Key differences vs the GPU path (vllm/models/gpt-oss-20b/model.env):
#   - SOURCE_FOLDER = raw bf16 weights in S3 (input to compile job)
#   - MODEL_FOLDER  = compiled NEFF cache in S3 (served by vLLM-Neuron)
#   - NEURON_CORES drives --tensor-parallel-size AND the device plugin request.
#     Must match the value used at compile time. Changing it requires recompile.
#   - No PVC — Neuron loads NEFFs directly from S3, no local metadata cache needed.
# ==============================================================================

export MODEL_ID="gpt-oss-20b-neuron"
export MODEL_HF_ID="openai/gpt-oss-20b"

# S3 folder with the raw bf16 weights — used by the compile job as INPUT.
export SOURCE_FOLDER="gpt-oss-20b"

# S3 folder that holds compiled NEFF artifacts — used by the deployment as the model path.
# Created by compile-job.yaml on first run; reused on every subsequent deploy.
# NOTE: gpt_oss architecture is not supported by optimum-neuron exporter (as of 2026-09-10).
# Using SOURCE_FOLDER (bf16 weights) directly so vLLM-Neuron can attempt JIT compilation.
export MODEL_FOLDER="gpt-oss-20b"

export SERVED_NAME="gpt-oss-20b"           # --served-model-name (same as GPU path)
export MODEL_S3_PATH="s3://\${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-gpt-oss-20b-neuron"
export SERVICE_NAME="oai-infopt-vllm-gpt-oss-20b-neuron"

# ── Hardware defaults ─────────────────────────────────────────────────────────
# trn1.32xlarge = 16 NeuronCores (8 chips × 2 cores/chip).
# NEURON_CORES must equal the tensor-parallel degree used at compile time.
# Changing this requires a recompile.
export NEURON_INSTANCE_TYPE="trn2.48xlarge"
# tp=8 per official AWS vLLM-Neuron quickstart for gpt-oss-20b.
export NEURON_CORES="8"

# Compile-time bucket parameters — must match compile-job.yaml.
export SEQ_LEN="16384"
export BATCH_SIZE="8"

export MANIFEST_PATH="configs/manifests/gpt-oss-20b-trn1-bf16.yaml"
export PORT_FORWARD_PORT="8082"            # avoids conflict with GPU gpt-oss-20b (8081)
