# ==============================================================================
# vllm/models/neuron/model.env
#
# Single-instance (non-DI) gpt-oss-20b on Trainium. Sourced by deploy.sh/stop.sh.
# ==============================================================================

export MODEL_ID="gpt-oss-20b-neuron"
export MODEL_HF_ID="openai/gpt-oss-20b"
# What vLLM-Neuron loads. Default = HF id per the tested recipe (downloads to the
# cache PVC via --download-dir). Alternative: a pre-staged local path on /cache.
export MODEL_REF="openai/gpt-oss-20b"
export SERVED_NAME="gpt-oss-20b"                 # keep same served name as the GPU cell

export DEPLOYMENT_NAME="oai-infopt-vllm-${MODEL_ID}"
export SERVICE_NAME="oai-infopt-vllm-${MODEL_ID}"
export PVC_NAME="oai-infopt-neuron-cache-gpt-oss-20b"

# ── Hardware (overridden per run by deploy.sh --hw) ──────────────────────────
# trn3.* → MXFP4 (native, like-for-like with the GPU cells), trn2.* → BF16.
# FILL: set the exact Trn3 instance type that is bookable in your region.
export NODE_INSTANCE_TYPE="trn3.48xlarge"        # FILL exact Trn3 type | or trn2.48xlarge for BF16
# TP8 = 8 NeuronCores. Set NEURON_DEVICE_COUNT = number of CHIPS providing 8 cores:
#   Trn3: 1 chip = 8 NeuronCore-v4  → "1"
#   Trn2: ~4 chips for 8 cores       → "4"  (verify cores/chip)
# Also confirm the device-plugin resource NAME: aws.amazon.com/neuron (chips) vs
# aws.amazon.com/neuroncore (cores).  Check:
#   kubectl describe node <trn-node> | grep -i neuron
export NEURON_DEVICE_COUNT="1"                   # Trn3 default (1 chip = TP8); set "4" for Trn2

export MANIFEST_PATH="configs/manifests/gpt-oss-20b-trn3-mxfp4.yaml"
export PORT_FORWARD_PORT="8090"
