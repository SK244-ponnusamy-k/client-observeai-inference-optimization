# ==============================================================================
# vllm/models/qwen3-5-4b-torchneuro/model.env
#
# TorchNeuron-native serving path for Qwen/Qwen3.5-4B on AWS Trainium2.
#
# This is the SIMPLEST Neuron path: TorchNeuron registers Trainium as a standard
# PyTorch device (PrivateUse1 / "neuron"), so the model loads with:
#
#   model = AutoModelForCausalLM.from_pretrained(..., device_map="neuron")
#
# and vLLM Neuron serves it with a plain `vllm serve` command (no custom NxDI
# modeling code, no ConfigMaps, no FastAPI shim). This mirrors the clean
# gpt-oss-20b-neuron pattern exactly.
#
# TorchNeuron announced Oct 20 2026 — public beta installed via:
#   pip install torch-neuronx  (AWS Neuron pip repo)
#
# Workflow:
#   First deploy  :  bash deploy.sh --compile   # traces NEFF -> S3 cache
#   Subsequent    :  bash deploy.sh             # reuses cache (fast start)
#
# Sourced by deploy.sh and stop.sh.
# ==============================================================================

export MODEL_ID="qwen3-5-4b-torchneuro"
export MODEL_HF_ID="Qwen/Qwen3.5-4B"

# S3 folder with the raw bf16 HF weights (shared with other qwen paths — download once).
export SOURCE_FOLDER="Qwen3.5-4B"
# S3 folder the deployment serves from (weights already local; this is also the
# source for the init-container model sync).
export MODEL_FOLDER="Qwen3.5-4B"
# S3 folder for compiled NEFF artifacts produced by the compile job.
export NEFF_FOLDER="qwen3-5-4b-torchneuro-neff"

export SERVED_NAME="Qwen3.5-4B"
export MODEL_S3_PATH="s3://${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-qwen3-5-4b-torchneuro"
export SERVICE_NAME="oai-infopt-vllm-qwen3-5-4b-torchneuro"

# ── Hardware defaults ─────────────────────────────────────────────────────────
# Target trn2.3xlarge (1 Trainium2 chip, LNC=2 → 4 logical cores for TP=4).
export NEURON_INSTANCE_TYPE="trn2.3xlarge"
# LNC=2: fuse 2 physical NeuronCores into 1 logical core on trn2.
# Must be identical at compile AND serve time.
export NEURON_LOGICAL_NC_CONFIG="2"
# NEURON_CORES = tensor-parallel degree. 4 logical cores on a single trn2 chip with LNC=2.
export NEURON_CORES="4"

# ── vLLM / TorchNeuron serving parameters ─────────────────────────────────────
# These are baked into the compiled NEFF — changing them requires a recompile.
export SEQ_LEN="8192"
export BATCH_SIZE="8"
export NUM_SEQS_BUCKETS="1,2,4,8"
export NUM_BATCHED_TOKENS_BUCKETS="2048,4096,8192"

export MANIFEST_PATH="configs/manifests/qwen3-5-4b-torchneuro-trn2-bf16.yaml"
export PORT_FORWARD_PORT="8152"

# ── Managed node group fallback (used with --managed-ng) ─────────────────────
export TRN2_NODEGROUP_NAME="trn2-neuron"
