# ==============================================================================
# vllm/models/qwen3-35b-nvfp4/model.env
#
# Model-specific configuration — sourced by deploy.sh and stop.sh.
# All names derive from MODEL_ID so scripts stay generic.
# ==============================================================================

export MODEL_ID="qwen3-35b-nvfp4"
export MODEL_HF_ID="nvidia/Qwen3.6-35B-A3B-NVFP4"
export MODEL_FOLDER="Qwen3.6-35B-A3B-NVFP4"                # S3 folder name
export MODEL_S3_PATH="s3://\${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-${MODEL_ID}"
export SERVICE_NAME="oai-infopt-vllm-${MODEL_ID}"
export PVC_NAME="oai-infopt-metadata-${MODEL_ID}"

export MANIFEST_PATH="configs/manifests/qwen3-35b-nvfp4-baseline.yaml"
export PORT_FORWARD_PORT="8082"                             # 8080=qwen-0.5b, 8081=gpt-oss-20b
