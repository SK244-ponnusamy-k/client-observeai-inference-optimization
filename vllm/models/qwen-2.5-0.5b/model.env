# ==============================================================================
# vllm/models/qwen-2.5-0.5b/model.env
#
# Model-specific configuration — sourced by deploy.sh and stop.sh.
# ==============================================================================

export MODEL_ID="qwen-0-5b"
export MODEL_HF_ID="Qwen/Qwen2.5-0.5B-Instruct"
export MODEL_FOLDER="Qwen2.5-0.5B-Instruct"               # S3 folder name
export SERVED_NAME="Qwen2.5-0.5B-Instruct"               # --served-model-name
export MODEL_S3_PATH="s3://\${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-${MODEL_ID}"
export SERVICE_NAME="oai-infopt-vllm-${MODEL_ID}"
export PVC_NAME="oai-infopt-metadata-${MODEL_ID}"

# ── Hardware defaults (overridden per run by deploy.sh --hw / --tp) ───────────
# 0.5B smoke test — fits any card. Cheapest single GPU by default.
export NODE_INSTANCE_TYPE="g6e.xlarge"      # g5.xlarge | g6.xlarge | g6e.xlarge
export TP_SIZE="1"
export GPU_COUNT="1"

export MANIFEST_PATH="configs/manifests/qwen-2.5-0.5b-baseline.yaml"
export PORT_FORWARD_PORT="8080"
