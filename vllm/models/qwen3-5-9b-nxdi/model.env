# ==============================================================================
# vllm/models/qwen3-5-9b-nxdi/model.env
#
# NxDI (NeuronX Distributed Inference) serving path for Qwen3.5-9B.
#
# Qwen3.5 is a hybrid DeltaNet + GQA decoder that vLLM-Neuron does NOT support
# out of the box. This path serves the reference contrib modeling code
# (src/modeling_qwen35.py + custom NKI DeltaNet kernels) behind an
# OpenAI-compatible FastAPI shim (server.py) on :8000, so the benchmark /
# observability / teardown stages are identical to every other model.
#
# Sourced by deploy.sh and stop.sh.
#
# Workflow: first deploy with --compile (produces the traced/sharded artifact
# in S3), then every later deploy reuses it and starts fast.
#   oai-style:  bash deploy.sh --compile    # first time
#               bash deploy.sh              # subsequent (fast)
# ==============================================================================

export MODEL_ID="qwen3-5-9b-nxdi"
export MODEL_HF_ID="Qwen/Qwen3.5-9B"

# S3 folder with the bf16 HF weights.
export SOURCE_FOLDER="qwen3-5-9b-tp1"
export MODEL_FOLDER="qwen3-5-9b-tp1"
# S3 folder for the compiled NxDI traced/sharded artifact.
# TEXT-ONLY build: the VL-traced artifact (qwen3-5-9b-nxdi-traced) executes the
# DeltaNet kernel fine but its 24-input VL forward signature is incompatible
# with the installed NxDI SDK 2.31.1 generation dispatch (drops argument_9).
# QWEN35_TEXT_ONLY=1 traces a text-only graph (no mrope/vision inputs) so the
# stock text generation path works. Stored in a SEPARATE S3 folder so the
# original VL artifact is preserved for fallback.
export QWEN35_TEXT_ONLY="1"
export COMPILED_FOLDER="qwen3-5-9b-nxdi-textonly-traced"

export SERVED_NAME="Qwen3.5-9B"
export MODEL_S3_PATH="s3://${MODEL_BUCKET}/${MODEL_FOLDER}/"
export COMPILED_S3_PATH="s3://${MODEL_BUCKET}/${COMPILED_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-qwen3-5-9b-nxdi"
export SERVICE_NAME="oai-infopt-vllm-qwen3-5-9b-nxdi"

# ── Hardware defaults ─────────────────────────────────────────────────────────
# Target trn2.48xlarge (16 logical cores at LNC=2, TP=16).
# The reference contrib was VALIDATED on trn2.48xlarge at TP=4; TP=16 uses all
# 16 logical cores across 8 chips. A full recompile is required on this instance.
# 9B is larger than 4B (hidden 4096 vs 2560, no tied embeddings) — trn2.48xlarge
# provides ample HBM for the full context at TP=16.
export NEURON_INSTANCE_TYPE="trn2.48xlarge"
export NEURON_LOGICAL_NC_CONFIG="2"
# TP=16 compiled+loaded but FAILED on-device execution: the custom DeltaNet NKI
# graph hangs on an ALLGATHER collective at TP=16 (NRT_TIMEOUT / status=101 on
# every forward pass). The reference contrib was validated at TP=4, so drop to
# TP=4 (= 4 NeuronCores) — the known-good config. Uses 4 of 16 cores on trn2.48xl.
export NEURON_CORES="4"

# ── NxDI compile-time parameters (BAKED into the compiled artifact) ──────────
# Compile-time params BAKED into the artifact. compile.py and server.py must
# agree with these or the traced NEFF won't load.
#
# QWEN35_MAX_BATCH_SIZE drives ctx_batch_size (prefill). With enable_bucketing
# unavailable in this NxDI build (sdk2.31.1 NeuronConfig rejects bucket kwargs),
# the prefill graph is compiled at the FULL [batch, seq_len, hidden]. batch=16
# overflowed Trainium2 HBM (NCC_EVRF009, ~54GB/core vs 24GB); batch=4 fits.
#
# QWEN35_SEQ_LEN: compiling the 8192 prefill as one monolithic graph OOMed the
# host even at 240Gi (4.8M-instruction module). This build can't bucket, so the
# artifact was compiled at 4096 and this MUST match or server.py load() will
# mismatch the traced config. 4096 is ample for the benchmark/quality workloads
# (~1.5k tokens/request). Raising back to 8192 needs a bucketing-capable image.
# QWEN35_TP_DEGREE=4: reference-validated degree (TP had no effect on the hang).
# QWEN35_SEQ_LEN=2048: the DeltaNet CTE kernel hangs on-device at 4096 (32
# in-kernel chunks). Dropped to 2048 (16 chunks) AND switched to USE_NKI_CHUNKED
# (per-chunk kernel) to cut per-call work. Still covers the benchmark workload
# (random_input_len=1024, max_new_tokens=512 ≈ 1536 tokens < 2048). RECOMPILE.
export QWEN35_SEQ_LEN="2048"
export QWEN35_MAX_BATCH_SIZE="4"
export QWEN35_TP_DEGREE="4"
export QWEN35_LOGICAL_NC_CONFIG="2"
export QWEN35_TORCH_DTYPE="bfloat16"
export QWEN35_TOP_K_ON_DEVICE="1"

export MANIFEST_PATH="configs/manifests/qwen3-5-9b-nxdi-trn2-bf16.yaml"
export PORT_FORWARD_PORT="8151"

# ── Managed node group fallback (used with --managed-ng) ─────────────────────
export TRN2_NODEGROUP_NAME="trn2-neuron"
