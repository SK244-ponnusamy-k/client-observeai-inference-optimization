# ==============================================================================
# vllm/models/qwen3-5-9b-nxdi/model.env
#
# NxDI (NeuronX Distributed Inference) serving path for Qwen3.5-9B.
#
# Qwen3.5 is a hybrid DeltaNet + GQA decoder that vLLM-Neuron does NOT support
# out of the box. This path serves the reference contrib modeling code
# (src/modeling_qwen35.py + custom NKI DeltaNet kernels) behind an
# OpenAI-compatible FastAPI shim (server.py) on :8000, so the benchmark /
# observability / teardown stages are identical to every other model.
#
# Sourced by deploy.sh and stop.sh.
#
# Workflow: first deploy with --compile (produces the traced/sharded artifact
# in S3), then every later deploy reuses it and starts fast.
#   oai-style:  bash deploy.sh --compile    # first time
#               bash deploy.sh              # subsequent (fast)
# ==============================================================================

export MODEL_ID="qwen3-5-9b-nxdi"
export MODEL_HF_ID="Qwen/Qwen3.5-9B"

# S3 folder with the bf16 HF weights.
export SOURCE_FOLDER="Qwen3.5-9B"
export MODEL_FOLDER="Qwen3.5-9B"
# S3 folder for the compiled NxDI traced/sharded artifact.
export COMPILED_FOLDER="qwen3-5-9b-nxdi-traced"

export SERVED_NAME="Qwen3.5-9B"
export MODEL_S3_PATH="s3://${MODEL_BUCKET}/${MODEL_FOLDER}/"
export COMPILED_S3_PATH="s3://${MODEL_BUCKET}/${COMPILED_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-qwen3-5-9b-nxdi"
export SERVICE_NAME="oai-infopt-vllm-qwen3-5-9b-nxdi"

# ── Hardware defaults ─────────────────────────────────────────────────────────
# Target trn2.3xlarge (1 Trainium2 chip, LNC=2 -> 4 logical cores for TP=4).
# NOTE: the reference contrib was VALIDATED on trn2.48xlarge. 3xlarge is our
# cost-optimized target for bring-up; see README for the 48xlarge fallback.
# 9B is larger than 4B (hidden 4096 vs 2560, no tied embeddings) — if it does
# not fit a single trn2.3xlarge chip at the chosen seq_len, fall back to
# trn2.48xlarge (set NEURON_INSTANCE_TYPE below and the node group selector).
export NEURON_INSTANCE_TYPE="trn2.3xlarge"
export NEURON_LOGICAL_NC_CONFIG="2"
export NEURON_CORES="4"

# ── NxDI compile-time parameters (BAKED into the compiled artifact) ──────────
# seq_len=160 is the reference-validated baseline. To push context length,
# raise QWEN35_SEQ_LEN here AND recompile — larger values are UNVALIDATED and
# may hit HBM limits on a single trn2.3xlarge chip (see README).
export QWEN35_SEQ_LEN="8192"
export QWEN35_MAX_BATCH_SIZE="1"
export QWEN35_TP_DEGREE="4"
export QWEN35_LOGICAL_NC_CONFIG="2"
export QWEN35_TORCH_DTYPE="bfloat16"
export QWEN35_TOP_K_ON_DEVICE="1"

export MANIFEST_PATH="configs/manifests/qwen3-5-9b-nxdi-trn2-bf16.yaml"
export PORT_FORWARD_PORT="8151"

# ── Managed node group fallback (used with --managed-ng) ─────────────────────
export TRN2_NODEGROUP_NAME="trn2-neuron"
