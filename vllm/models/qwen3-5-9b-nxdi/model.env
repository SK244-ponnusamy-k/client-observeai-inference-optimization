# ==============================================================================
# vllm/models/qwen3-5-9b-nxdi/model.env
#
# NxDI (NeuronX Distributed Inference) serving path for Qwen3.5-9B.
#
# Qwen3.5 is a hybrid DeltaNet + GQA decoder that vLLM-Neuron does NOT support
# out of the box. This path serves the reference contrib modeling code
# (src/modeling_qwen35.py + custom NKI DeltaNet kernels) behind an
# OpenAI-compatible FastAPI shim (server.py) on :8000.
#
# Sourced by deploy.sh and stop.sh.
#
# ------------------------------------------------------------------------------
# HOW TO SWITCH BUILDS
#   This file has ONE shared section (always active) + TWO build blocks below.
#   Exactly ONE build block must be uncommented at a time.
#     * BUILD A = 10k / continuous-batching / DP16  (needs --compile, new S3)
#     * BUILD B = running 2048 fallback             (no --compile)
#   To switch: comment the whole active block, uncomment the other one.
#     bash deploy.sh --compile   # BUILD A, first time (writes the artifact)
#     bash deploy.sh             # subsequent / BUILD B (reuses the artifact)
# ==============================================================================


# ==============================================================================
# SHARED  —  identical for every build; leave this section ALWAYS active.
# ==============================================================================
export MODEL_ID="qwen3-5-9b-nxdi"
export MODEL_HF_ID="Qwen/Qwen3.5-9B"

# S3 folder with the bf16 HF weights (input to compile; synced to /model).
export SOURCE_FOLDER="qwen3-5-9b-tp1"
export MODEL_FOLDER="qwen3-5-9b-tp1"

export SERVED_NAME="Qwen3.5-9B"
export DEPLOYMENT_NAME="oai-infopt-vllm-qwen3-5-9b-nxdi"
export SERVICE_NAME="oai-infopt-vllm-qwen3-5-9b-nxdi"

# Custom modeling code gate (both builds): text-only traced graph (no VL inputs).
export QWEN35_TEXT_ONLY="1"

# Hardware: trn2.48xlarge = 16 Trainium2 chips = 64 logical cores at LNC=2.
# One TP=4 replica = 1 chip. Both builds use TP=4 + DP16 (one replica per chip).
export NEURON_INSTANCE_TYPE="trn2.48xlarge"
export NEURON_LOGICAL_NC_CONFIG="2"
export NEURON_CORES="4"                 # cores per replica (= TP)
export QWEN35_DP_REPLICAS="1"           # TEMP: 1 for the 10k decode-fix test; set back to 16 for benchmarks (16 x TP4 = all 64 logical cores)
export QWEN35_DP_START_PARALLEL="4"     # replicas loading at once after replica 0

# Precision / sampling (both builds).
export QWEN35_TP_DEGREE="4"
export QWEN35_LOGICAL_NC_CONFIG="2"
export QWEN35_TORCH_DTYPE="bfloat16"
export QWEN35_TOP_K_ON_DEVICE="1"

export MANIFEST_PATH="configs/manifests/qwen3-5-9b-nxdi-trn2-bf16.yaml"
export PORT_FORWARD_PORT="8151"
export TRN2_NODEGROUP_NAME="trn2-neuron"   # managed node-group fallback (--managed-ng)

# Derived S3 paths (use COMPILED_FOLDER set by the active build block below).
# NOTE: these reference COMPILED_FOLDER, so keep them AFTER the build block when
# sourcing — deploy.sh re-sources, so order within this file is fine either way.


# ==============================================================================
# BUILD A (ACTIVE)  —  10k context / continuous batching / DP16   [RECOMPILE]
#
# Compile config baked into the artifact (vs the 2048 fallback):
#   SEQ_LEN            2048  -> 10240     prompt (<=8192) + generation
#   MAX_CONTEXT_LEN    2048  -> 8192      dataset max prompt ~7.6k tokens
#   CONTEXT_BUCKETS    none  -> 1024,2048,4096,8192   short prompts stay cheap
#   TKG_BUCKETS        2048  -> 10240
#   CTX_BATCH_SIZE     4     -> 1         prefill one request at a time
#   MAX_BATCH_SIZE     4     -> 8         decode batch per replica
#   CONTINUOUS_BATCHING off  -> on
#   COMPILED_FOLDER    ...-traced -> ...-10k-cb8-traced   NEW S3 (old preserved)
#   TP/LNC 4/2, USE_NKI_CHUNKED, TEXT_ONLY = unchanged.
# Largest prefill graph 1 x 8192 = same token-slots as validated 4 x 2048.
# If compile hits NCC_EVRF009 (HBM): set MAX_BATCH_SIZE=4, clear the S3 folder,
# recompile. Serving (DP16 router, streaming, right-pad, /metrics, 120-min
# startup, NEFF cached to S3) is wired in server.py/router.py/deployment.yaml.
# First deploy: ./oai deploy qwen3-5-9b-nxdi --compile   (~2-3 h)
# ------------------------------------------------------------------------------
# v2 = decode fix (TROUBLESHOOTING #14): NKI argmax kernel off + modeling guards.
# v1 artifact (...-10k-cb8-traced) is kept in S3 but its decode returns garbage ids.
# export COMPILED_FOLDER="qwen3-5-9b-nxdi-textonly-10k-cb8-v2-traced"
# export QWEN35_DISABLE_ARGMAX_KERNEL="1"
# export QWEN35_SEQ_LEN="10240"
# export QWEN35_MAX_CONTEXT_LEN="8192"
# export QWEN35_CONTEXT_BUCKETS="1024,2048,4096,8192"
# export QWEN35_TKG_BUCKETS="10240"
# export QWEN35_MAX_BATCH_SIZE="8"
# export QWEN35_CTX_BATCH_SIZE="1"
# export QWEN35_CONTINUOUS_BATCHING="1"


# ==============================================================================
# BUILD B (fallback)  —  running 2048 build (commit c15c5af)   [NO recompile]
#
# Known-good artifact s3://.../qwen3-5-9b-nxdi-textonly-traced/ (NEFF embedded
# in model.pt). To use: comment BUILD A above, uncomment this block, then
#   ./oai deploy qwen3-5-9b-nxdi        (NO --compile)
# Static batch 4, seq 2048; prompts must be <= 2048 tokens. DP16 still applies
# (16 copies of the 2048 artifact) from the SHARED section above.
# ------------------------------------------------------------------------------
export COMPILED_FOLDER="qwen3-5-9b-nxdi-textonly-traced"
export QWEN35_SEQ_LEN="2048"
export QWEN35_MAX_CONTEXT_LEN="2048"
export QWEN35_CONTEXT_BUCKETS="2048"
export QWEN35_TKG_BUCKETS="2048"
export QWEN35_MAX_BATCH_SIZE="4"
export QWEN35_CTX_BATCH_SIZE="4"
export QWEN35_CONTINUOUS_BATCHING="0"
export QWEN35_DISABLE_ARGMAX_KERNEL="0"


# ==============================================================================
# Derived S3 paths (reference the active COMPILED_FOLDER above).
# ==============================================================================
export MODEL_S3_PATH="s3://${MODEL_BUCKET}/${MODEL_FOLDER}/"
export COMPILED_S3_PATH="s3://${MODEL_BUCKET}/${COMPILED_FOLDER}/"
