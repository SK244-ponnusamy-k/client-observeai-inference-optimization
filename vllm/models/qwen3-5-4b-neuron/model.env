# ==============================================================================
# vllm/models/qwen3-5-4b-neuron/model.env
#
# Neuron / Trainium serving path for Qwen3.5-4B.
# Sourced by deploy.sh and stop.sh.
# ==============================================================================

export MODEL_ID="qwen3-5-4b-neuron"
export MODEL_HF_ID="Qwen/Qwen3.5-4B"

# S3 folder with the bf16 weights — download job INPUT.
export SOURCE_FOLDER="Qwen3.5-4B"
# S3 folder that holds the model the deployment serves from.
export MODEL_FOLDER="Qwen3.5-4B"
# S3 folder for compiled NEFF artifacts.
export NEFF_FOLDER="qwen3-5-4b-neuron"

export SERVED_NAME="Qwen3.5-4B"
export MODEL_S3_PATH="s3://${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-qwen3-5-4b-neuron"
export SERVICE_NAME="oai-infopt-vllm-qwen3-5-4b-neuron"

# ── Hardware defaults ─────────────────────────────────────────────────────────
export NEURON_INSTANCE_TYPE="trn2.3xlarge"
export NEURON_CORES="4"

# Compile-time parameters — must match compile-job.yaml.
export SEQ_LEN="8192"
export BATCH_SIZE="8"

export MANIFEST_PATH="configs/manifests/qwen3-5-4b-neuron-trn2-bf16.yaml"
export PORT_FORWARD_PORT="8147"

# ── Managed node group fallback (used with --managed-ng) ─────────────────────
export TRN2_NODEGROUP_NAME="trn2-neuron"
