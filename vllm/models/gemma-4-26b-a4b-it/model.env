# ==============================================================================
# vllm/models/gemma-4-26b-a4b-it/model.env
#
# Model-specific configuration — sourced by deploy.sh and stop.sh.
#
# Primary variant: 4-bit W4A16 (compressed-tensors) on a SINGLE GPU — fits g5,
# g6, and g6e. See docs/benchmark-matrix.md for the optional fp8-on-g6e variant
# (higher precision, single L40S) and the bf16 TP=4 quality-ceiling variant.
# ==============================================================================

export MODEL_ID="gemma-4-26b-a4b"
export MODEL_HF_ID="google/gemma-4-26B-A4B-it"
# S3 folder holds the 4-bit (W4A16) checkpoint. For the fp8 variant, point this
# at the fp8 folder and use the g6e-only manifest.
export MODEL_FOLDER="Gemma-4-26B-A4B-it-w4a16"            # S3 folder name
export SERVED_NAME="Gemma-4-26B-A4B-it"                  # --served-model-name
export MODEL_S3_PATH="s3://\${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-${MODEL_ID}"
export SERVICE_NAME="oai-infopt-vllm-${MODEL_ID}"
export PVC_NAME="oai-infopt-metadata-${MODEL_ID}"

# ── Hardware defaults (overridden per run by deploy.sh --hw / --tp) ───────────
# 4-bit ~14.4 GB → single GPU on ANY family (g5/g6 24 GB, g6e 48 GB). TP=1.
export NODE_INSTANCE_TYPE="g6e.2xlarge"     # g5.2xlarge | g6.2xlarge | g6e.2xlarge
export TP_SIZE="1"
export GPU_COUNT="1"

export MANIFEST_PATH="configs/manifests/gemma-4-26b-a4b-g6e-w4a16.yaml"
export PORT_FORWARD_PORT="8084"
