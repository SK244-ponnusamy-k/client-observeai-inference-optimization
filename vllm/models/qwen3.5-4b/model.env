# ==============================================================================
# vllm/models/qwen3.5-4b/model.env
#
# Model-specific configuration — sourced by deploy.sh and stop.sh.
# All names derive from MODEL_ID so scripts stay generic.
#
# MODEL_ID is K8s-safe (dashes only, no dots). The HF id / served name / S3 folder
# keep the real "3.5" naming.
# ==============================================================================

export MODEL_ID="qwen3-5-4b"
export MODEL_HF_ID="Qwen/Qwen3.5-4B"
export MODEL_FOLDER="Qwen3.5-4B"                           # S3 folder name
export SERVED_NAME="Qwen3.5-4B"                            # --served-model-name
export MODEL_S3_PATH="s3://\${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-${MODEL_ID}"
export SERVICE_NAME="oai-infopt-vllm-${MODEL_ID}"
export PVC_NAME="oai-infopt-metadata-${MODEL_ID}"

# ── Hardware defaults (overridden per run by deploy.sh --hw / --tp) ───────────
# Qwen3.5-4B is ~9 GB bf16 → single GPU on ANY family. TP not needed.
export NODE_INSTANCE_TYPE="g6e.2xlarge"     # g5.2xlarge | g6.2xlarge | g6e.2xlarge
export TP_SIZE="1"
export GPU_COUNT="1"

export MANIFEST_PATH="configs/manifests/qwen3.5-4b-g6e-bf16.yaml"
export PORT_FORWARD_PORT="8083"
