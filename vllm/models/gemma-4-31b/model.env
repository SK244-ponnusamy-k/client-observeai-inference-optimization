# ==============================================================================
# vllm/models/gemma-4-31b/model.env
#
# Model-specific configuration — sourced by deploy.sh and stop.sh.
# All names derive from MODEL_ID so scripts stay generic.
#
# NOTE: this points at google/gemma-4-31B-it (instruction-tuned). The BASE
# checkpoint (google/gemma-4-31B) was tried first and confirmed at deploy time
# to have no chat_template, which vLLM's /v1/chat/completions endpoint (used
# by inference/load-test.py) requires — every request failed with a 400.
# Switched to -it to get a working chat template.
# ==============================================================================

export MODEL_ID="gemma-4-31b"
export MODEL_HF_ID="google/gemma-4-31B-it"
export MODEL_FOLDER="gemma-4-31B-it"                        # S3 folder name
export MODEL_S3_PATH="s3://\${MODEL_BUCKET}/${MODEL_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-${MODEL_ID}"
export SERVICE_NAME="oai-infopt-vllm-${MODEL_ID}"
export PVC_NAME="oai-infopt-metadata-${MODEL_ID}"

export MANIFEST_PATH="configs/manifests/gemma-4-31b-baseline.yaml"
export PORT_FORWARD_PORT="8083"                             # 8080=qwen-0.5b, 8081=gpt-oss-20b, 8082=qwen3-35b-nvfp4
