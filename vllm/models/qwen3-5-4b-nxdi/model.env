# ==============================================================================
# vllm/models/qwen3-5-4b-nxdi/model.env
#
# NxDI (NeuronX Distributed Inference) serving path for Qwen3.5-4B.
#
# Qwen3.5 is a hybrid DeltaNet + GQA decoder that vLLM-Neuron does NOT support
# out of the box. This path serves the reference contrib modeling code
# (src/modeling_qwen35.py + custom NKI DeltaNet kernels) behind an
# OpenAI-compatible FastAPI shim (server.py) on :8000, so the benchmark /
# observability / teardown stages are identical to every other model.
#
# Sourced by deploy.sh and stop.sh.
#
# Workflow: first deploy with --compile (produces the traced/sharded artifact
# in S3), then every later deploy reuses it and starts fast.
#   oai-style:  bash deploy.sh --compile    # first time
#               bash deploy.sh              # subsequent (fast)
# ==============================================================================

export MODEL_ID="qwen3-5-4b-nxdi"
export MODEL_HF_ID="Qwen/Qwen3.5-4B"

# S3 folder with the bf16 HF weights — shared with the GPU path (download once).
export SOURCE_FOLDER="Qwen3.5-4B"
export MODEL_FOLDER="Qwen3.5-4B"
# S3 folder for the compiled NxDI traced/sharded artifact.
export COMPILED_FOLDER="qwen3-5-4b-nxdi-traced"

export SERVED_NAME="Qwen3.5-4B"
export MODEL_S3_PATH="s3://${MODEL_BUCKET}/${MODEL_FOLDER}/"
export COMPILED_S3_PATH="s3://${MODEL_BUCKET}/${COMPILED_FOLDER}/"

export DEPLOYMENT_NAME="oai-infopt-vllm-qwen3-5-4b-nxdi"
export SERVICE_NAME="oai-infopt-vllm-qwen3-5-4b-nxdi"

# ── Hardware defaults ─────────────────────────────────────────────────────────
# Target trn2.48xlarge (16 logical cores at LNC=2, TP=16).
# The reference contrib was VALIDATED on trn2.48xlarge at TP=4; TP=16 uses all
# 16 logical cores across 8 chips. A full recompile is required on this instance.
export NEURON_INSTANCE_TYPE="trn2.48xlarge"
# LNC=2: fuse 2 physical NeuronCores into 1 logical core on trn2. Must be
# identical at compile AND serve time.
export NEURON_LOGICAL_NC_CONFIG="2"
# TP degree = number of logical NeuronCores. Must match the compiled artifact.
export NEURON_CORES="16"

# ── NxDI compile-time parameters (BAKED into the compiled artifact) ──────────
# IMPORTANT: QWEN35_TP_DEGREE=16 is baked at compile time. The existing
# trn2.3xlarge artifact (TP=4) is incompatible — run deploy.sh --compile first.
export QWEN35_SEQ_LEN="8192"
export QWEN35_MAX_BATCH_SIZE="16"
export QWEN35_TP_DEGREE="16"
export QWEN35_LOGICAL_NC_CONFIG="2"
export QWEN35_TORCH_DTYPE="bfloat16"
export QWEN35_TOP_K_ON_DEVICE="1"

export MANIFEST_PATH="configs/manifests/qwen3-5-4b-nxdi-trn2-bf16.yaml"
export PORT_FORWARD_PORT="8150"

# ── Managed node group fallback (used with --managed-ng) ─────────────────────
export TRN2_NODEGROUP_NAME="trn2-neuron"
