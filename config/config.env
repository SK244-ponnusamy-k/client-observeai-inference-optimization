# ==============================================================================
# config/config.env
#
# Single source of truth for all runtime settings.
# Every script sources this file — change values here only.
# NO secrets or credentials in this file — those live in AWS Secrets Manager.
#
# REUSE GUIDE — what is already created vs what is new:
#
#   ALREADY CREATED (keep as-is, just referenced here):
#     - EKS cluster      : ai-eks-cluster
#     - S3 model bucket  : shellkode-ai-models
#     - IAM role (legacy): ModelStorageRole  (still works; new roles are additive)
#     - ServiceAccount   : model-storage-sa  (still works in default namespace)
#     - Namespace        : default
#
#   NEW (created by setup-pod-identity.sh — lightweight additions):
#     - IAM role (download) : oai-infopt-download-role  (S3 write + Secrets Manager)
#     - IAM role (serving)  : oai-infopt-serving-role   (S3 read-only — replaces ModelStorageRole for vLLM pods)
#     - IAM role (benchmark): oai-infopt-benchmark-role (results bucket write + CloudWatch)
#     - ServiceAccounts     : oai-infopt-*-sa  in namespace oai-infopt
#     - S3 results bucket   : shellkode-ai-results (new — for benchmark output)
#     - HF token secret     : oai-infopt/hf-token in Secrets Manager
#
# Usage:
#   source config/config.env
# ==============================================================================

# ------------------------------------------------------------------------------
# AWS Settings
# NOTE: Never hardcode account IDs in committed files — auto-detected by scripts.
# ------------------------------------------------------------------------------
export AWS_REGION="${AWS_REGION:-us-east-2}"                  # override via env if needed
export AWS_ACCOUNT_ID=""                                       # auto-populated by scripts

# ------------------------------------------------------------------------------
# EKS Cluster — REUSE your existing cluster
# ------------------------------------------------------------------------------
export CLUSTER_NAME="ai-eks-cluster"                          # YOUR existing cluster — no change
export EKS_VERSION="1.36"                                     # match your actual cluster version
export BENCHMARK_NAMESPACE="oai-infopt"                       # new dedicated namespace (not default)
export DOWNLOAD_NAMESPACE="oai-infopt"

# ------------------------------------------------------------------------------
# S3 — REUSE your existing model bucket; new results bucket is additive
# ------------------------------------------------------------------------------
export MODEL_BUCKET="shellkode-ai-models"                     # YOUR existing bucket — no change
export RESULTS_BUCKET="shellkode-ai-results"                  # NEW — for benchmark output
# Note: unlike model bucket, results bucket is created fresh by setup-pod-identity.sh

# ------------------------------------------------------------------------------
# IAM / Pod Identity — 3 SEPARATE LEAST-PRIVILEGE ROLES (new, additive)
#
# WHY 3 roles instead of 1 (ModelStorageRole):
#
#   Old ModelStorageRole gave every pod:
#     S3 GetObject + PutObject + DeleteObject + ListBucket
#   That means vLLM serving pods had write/delete on your model weights — unnecessary risk.
#
#   New split (principle of least privilege):
#     download-role   → S3 read+write on model bucket + Secrets Manager (HF token)
#                       used only by model-download Jobs
#     serving-role    → S3 read-ONLY on model bucket, nothing else
#                       used by vLLM Deployment pods (can't overwrite/delete weights)
#     benchmark-role  → S3 read+write on RESULTS bucket only + CloudWatch metrics
#                       used by benchmark runner
#
#   ModelStorageRole still exists — it is NOT deleted. The new roles are additive.
# ------------------------------------------------------------------------------
export DOWNLOAD_IAM_ROLE_NAME="oai-infopt-download-role"
export SERVING_IAM_ROLE_NAME="oai-infopt-serving-role"
export BENCHMARK_IAM_ROLE_NAME="oai-infopt-benchmark-role"

export DOWNLOAD_SERVICE_ACCOUNT="oai-infopt-download-sa"
export SERVING_SERVICE_ACCOUNT="oai-infopt-serving-sa"
export BENCHMARK_SERVICE_ACCOUNT="oai-infopt-benchmark-sa"

# Legacy — kept for backward compatibility with any scripts still using old SA
export SERVICE_ACCOUNT="model-storage-sa"                     # YOUR existing SA — unchanged
export NAMESPACE="default"                                     # YOUR existing namespace — unchanged

# ------------------------------------------------------------------------------
# Secrets Manager — HF token (new, replaces kubectl create secret)
# ------------------------------------------------------------------------------
export HF_TOKEN_SECRET_NAME="oai-infopt/hf-token"

# ------------------------------------------------------------------------------
# vLLM Container Image — pinned for reproducibility
# Verify the exact tag at: https://gallery.ecr.aws/deep-learning-containers/vllm
# ------------------------------------------------------------------------------
# Image digest pinned 2026-09-03 — resolves Checkov CKV_K8S_43 / CKV_K8S_14.
# Digest is the linux/amd64 OCI image manifest (not the SOCI index layer).
# To re-pin after an image update:
#   python -c "
#   import urllib.request, json, ssl, hashlib
#   ctx = ssl.create_default_context()
#   token_url = 'https://public.ecr.aws/token?service=public.ecr.aws&scope=repository:deep-learning-containers/vllm:pull'
#   with urllib.request.urlopen(token_url, context=ctx) as r: token = json.loads(r.read())['token']
#   tag = '0.26.0-gpu-py312-cu130-ubuntu22.04-ec2-v1.0-soci'
#   req = urllib.request.Request('https://public.ecr.aws/v2/deep-learning-containers/vllm/manifests/' + tag,
#       headers={'Authorization': 'Bearer ' + token, 'Accept': 'application/vnd.docker.distribution.manifest.list.v2+json'})
#   with urllib.request.urlopen(req, context=ctx) as r: body = json.loads(r.read())
#   for m in body['manifests']:
#       if m['platform']['os'] == 'linux' and m['platform']['architecture'] == 'amd64':
#           cfg_type = m.get('mediaType','')
#           if 'soci' not in cfg_type: print('amd64 runtime:', m['digest'])
#   "
export VLLM_IMAGE="public.ecr.aws/deep-learning-containers/vllm:0.26.0-gpu-py312-cu130-ubuntu22.04-ec2-v1.0-soci@sha256:e70d649d964dd0b568669453df523e764d23933987ea378d0f423cbe4ae56b81"

# ------------------------------------------------------------------------------
# AWS Resource Tags — MANDATORY on every resource
# Observe.AI will supply final tag convention; placeholders used until then.
# ------------------------------------------------------------------------------
export TAG_PROJECT="observeai-inference-optimization"
export TAG_ENGAGEMENT="shellkode-sow"
export TAG_ENVIRONMENT="sandbox"
export TAG_MANAGED_BY="eksctl"
export TAG_OWNER="TBD"                                        # update when assigned
export TAG_COST_CENTER="TBD"                                  # update when assigned
export TAG_COMPONENT="llm-inference"
export TAG_WORKLOAD="gpu-inference"
