#!/usr/bin/env bash
# ==============================================================================
# oai — launcher shim (Linux / macOS / Git Bash / WSL)
#
# Runs the Python `oai` CLI from tools/. Put this directory on your PATH, or call
# it as ./oai, so non-technical users just type:  oai model new
#
# Works with a native (POSIX) Python and with a WINDOWS Python invoked from
# Git Bash. In the latter case the tools/ path must be converted to a Windows
# path (via cygpath) so the Windows interpreter can resolve the `oai` package.
# ==============================================================================
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS_DIR="${SCRIPT_DIR}/tools"

# Pick the interpreter: OAI_PYTHON override, else python3, else python.
PYTHON_BIN="${OAI_PYTHON:-python3}"
command -v "${PYTHON_BIN}" >/dev/null 2>&1 || PYTHON_BIN="python"

# If cygpath exists (Git Bash / MSYS) AND the chosen interpreter is a Windows
# .exe, translate the tools path to a Windows-style path so PYTHONPATH resolves.
PYPATH="${TOOLS_DIR}"
case "${PYTHON_BIN}" in
    *.exe|/c/*|/[A-Za-z]/*)
        if command -v cygpath >/dev/null 2>&1; then
            PYPATH="$(cygpath -w "${TOOLS_DIR}")"
        fi
        ;;
esac

export PYTHONPATH="${PYPATH}${PYTHONPATH:+;${PYTHONPATH}}"
exec "${PYTHON_BIN}" -m oai.cli "$@"
