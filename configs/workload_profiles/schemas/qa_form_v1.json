{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QAFormV1",
  "description": "Expected output schema for QA form evaluation responses",
  "type": "object",
  "properties": {
    "compliance": {
      "type": "string",
      "enum": ["Met", "Failed", "Partial", "N/A"]
    },
    "verification": {
      "type": "string",
      "enum": ["Completed", "Skipped", "Partial", "N/A"]
    },
    "resolution": {
      "type": "string",
      "enum": ["Resolved", "Unresolved", "Escalated", "Pending", "N/A"]
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "notes": {
      "type": "string"
    }
  },
  "required": ["compliance", "verification", "resolution"]
}
